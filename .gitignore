# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example is committed on purpose)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Supabase CLI working directory. `supabase start` writes generated container
# secrets into .temp/start-secrets — never commit it.
supabase/.temp/

# Local basemap cache used to review the map without a Mapbox token. Nothing in
# the application references it. See docs/construction-markers.md.
/public/dev/tiles/
/public/dev/basemap-local.json
