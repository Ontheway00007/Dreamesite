# Copy this file to .env.local and fill in the values.
# Everything here is free-tier compatible: Supabase free project, Mapbox free
# tier, Vercel hobby.

# --- Supabase -----------------------------------------------------------------
# Project Settings -> Data API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / public key.
# Safe to expose in the browser only while row level security is enabled on
# every table the key can reach. The publishable-key format from newer projects
# is also accepted; the anon key remains the stable option for this SDK.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Mapbox -------------------------------------------------------------------
# account.mapbox.com -> Tokens -> public token (starts with pk.)
# Restrict it to your deployed domains before going live.
# Optional: without it, /properties shows the full list and a "map unavailable"
# panel instead of the map. Nothing crashes.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token

# Optional map style. Defaults to mapbox://styles/mapbox/dark-v11.
# Point this at a Mapbox Studio style when the branded one is ready.
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Site ---------------------------------------------------------------------
# Canonical origin, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Login protection ---------------------------------------------------------
# Cloudflare Turnstile, shown on the login form only after repeated failures.
# dash.cloudflare.com -> Turnstile -> Add site. Widget mode: Managed.
#
# Both keys or neither. A site key with no secret renders a widget whose response
# nothing verifies, which is worse than no widget at all.
#
# In a PRODUCTION deployment, leaving these unset does not skip the challenge —
# attempts that need one are refused. That is deliberate: a forgotten variable
# must not silently disable a control. Locally, unset means skipped so the form
# works out of the box.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing client addresses in the login throttle. Server-only secret.
# Generate with: openssl rand -hex 32
#
# Without it, addresses are not hashed and per-address throttling is SKIPPED —
# per-email throttling still applies. An unsalted hash of an IPv4 address is
# reversible in seconds, so the code returns null rather than hashing badly.
LOGIN_HASH_SALT=

# --- Security headers ---------------------------------------------------------
# Set to "true" to send Content-Security-Policy-Report-Only instead of enforcing,
# for a staged rollout on a new deployment. Enforcing is the default so that
# security is not opt-in. See docs/operations.md.
# CSP_REPORT_ONLY=true

# --- Server-only (never prefixed NEXT_PUBLIC_) --------------------------------
# The service-role key is NOT REQUIRED and is not read by any module.
#
# It used to be needed by the privacy projection generator. That generator now
# runs as the signed-in administrator and writes through an admin-checked,
# version-checked function, so RLS applies to everything it does. Nothing in the
# application asks for this key.
#
# Leave it unset. Setting it grants nothing and only creates a secret to leak.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Non-Vercel production deployments ----------------------------------------
# Set this to "production" on non-Vercel hosts (Docker, AWS, etc.) to prevent
# demonstration fixture data from leaking. Vercel sets VERCEL_ENV automatically.
# Do NOT set this during builds or CI — it would block static generation.
# DEPLOYMENT_ENV=production
