# Copy this file to .env.local and fill in the values.
# Everything here is free-tier compatible: Supabase free project, Mapbox free
# tier, Vercel hobby.

# --- Supabase -----------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> anon / public key.
# Safe to expose in the browser only while row level security is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Mapbox -------------------------------------------------------------------
# account.mapbox.com -> Tokens -> public token (starts with pk.)
# Restrict it to your deployed domains before going live.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-token

# --- Site ---------------------------------------------------------------------
# Canonical origin, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
